{
  "name": "datavault",
  "version": "0.1.0",
  "private": true,
  "description": "DataVault Query License – Monad Metropolis hackathon",
  "scripts": {
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.js --network monadTestnet",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "node": "hardhat node",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:worker": "cd worker && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "typecheck:worker": "cd worker && npm run typecheck",
    "install:all": "npm install && cd frontend && npm install && cd ../worker && npm install",
    "db:migrate:local": "cd worker && npm run db:migrate:local",
    "check:release-config": "node scripts/check-release-config.mjs",
    "smoke:public": "node scripts/smoke-public-site.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.6.1",
    "hardhat": "^2.22.0"
  }
}
